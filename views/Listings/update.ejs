<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StayNest : Update Listing</title>
</head>
<body>
    <h1>Edit Listing</h1>
    <hr>
    <form action="/listings/<%= listing._id %>?_method=PUT" method="post">
        <label for="title">Title : </label>
        <input type="text" id="title" name="title" value="<%= listing.title %>">&nbsp;&nbsp;
        <label for="price">Price : </label>
        <input type="number" id="price" name="price" value="<%= listing.price %>"><hr>
        <label for="descp">Description : </label><br>
        <textarea name="description" id="descp" cols="30" rows="5"><%= listing.description %></textarea><hr>
        <label for="img">Image-URL : </label>
        <input type="url" id="img" name="image" value="<%= listing.image %>">&nbsp;&nbsp;
        <label for="location">Location : </label>
        <input type="text" id="location" name="location" value="<%= listing.location %>">&nbsp;&nbsp;
        <label for="country">Country : </label>
        <input type="text" id="country" name="country" value="<%= listing.country %>">
        <hr>
        <button>Edit</button>
    </form>
</body>
</html>