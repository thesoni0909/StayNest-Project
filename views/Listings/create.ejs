<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StayNest : New Listing</title>
</head>
<body>
    <h1>Add new Listing</h1>
    <hr>
    <form action="/listings" method="post">
        <label for="title">Title : </label>
        <input type="text" id="title" name="title" placeholder="enter title..">&nbsp;&nbsp;
        <label for="price">Price : </label>
        <input type="number" id="price" name="price" placeholder="enter price.."><hr>
        <label for="descp">Description : </label><br>
        <textarea name="description" id="descp" cols="30" rows="5" placeholder="enter description.."></textarea><hr>
        <label for="img">Image-URL : </label>
        <input type="url" id="img" name="image" placeholder="enter image url..">&nbsp;&nbsp;
        <label for="location">Location : </label>
        <input type="text" id="location" name="location" placeholder="enter location..">&nbsp;&nbsp;
        <label for="country">Country : </label>
        <input type="text" id="country" name="country" placeholder="enter country..">
        <hr>
        <button>Add</button>
    </form>
</body>
</html>